{
  "manifest_version": 3,
  "name": "RehubPro CRM: передача переписки",
  "version": "0.1.0",
  "description": "Передаёт выбранный диалог WhatsApp Web или Instagram в обращение RehubPro CRM после просмотра.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.instagram.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Передать в CRM"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/direct/*"
      ],
      "js": ["content-loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js", "types.js", "adapters/*.js"],
      "matches": ["https://web.whatsapp.com/*", "https://www.instagram.com/*"]
    }
  ]
}
