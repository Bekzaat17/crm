# Только локальная разработка. Для рабочего окружения нужен отдельный конфиг.
CRM_DEBUG=1
CRM_SECRET_KEY=
CRM_ALLOWED_HOSTS=localhost,127.0.0.1
CRM_FRONTEND_URL=http://127.0.0.1:3100
CRM_TRUSTED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# sqlite — быстрый локальный запуск; postgres — отдельная БД из compose.
CRM_DB_ENGINE=sqlite
CRM_DB_NAME=rehubpro_crm
CRM_DB_USER=rehubpro_crm
CRM_DB_PASSWORD=
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=55440
CRM_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CRM_FROM_EMAIL=RehubPro CRM <noreply@localhost>
# CRM_EMAIL_HOST=
# CRM_EMAIL_PORT=587
# CRM_EMAIL_USER=
# CRM_EMAIL_PASSWORD=
# CRM_EMAIL_TLS=1

CRM_INTEGRATION_KEY=
CRM_CENTER_ALLOWED_DOMAINS=rehubpro.kz
